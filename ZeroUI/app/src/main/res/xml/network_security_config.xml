<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain HTTP is allowed for user-entered model addresses; the AI pages ask before using it. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
